# UART0 TX is GPIO20, which is the Quote/0 EPD power rail. Never let the IDF
# console claim it; USB Serial/JTAG (GPIO18/19) is the host transport.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# USB Serial/JTAG carries application messages, not a console. Suppress even the
# pre-application bootloader chatter so a host never mistakes text for a frame.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# 4 MiB custom layout: minimum-size 12 KiB NVS, OTA metadata, two 1.875 MiB
# app slots, and a 192 KiB LittleFS volume labelled `littlefs` (data/spiffs subtype required
# by esp_littlefs).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Renderer composition and projection keep full-frame temporaries on the stack.
# Hardware measurements approach 56 KiB; retain the verified 64 KiB allocation.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# Stack budgets for ESP-IDF background tasks.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# Larger application threads explicitly set their stack size when spawned.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Low-rate frame appliance: reserve room for the panel, BLE, and web uploads.
# Keep the RX aggregation window within the number of static RX buffers.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
# Prefer heap headroom over high-throughput Wi-Fi code in instruction RAM.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Release TLS record buffers between reads/writes; keep the full 16 KiB
# inbound record limit for ordinary HTTPS servers.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# The implemented BLE feature is a non-connectable BTHome beacon. Do not
# reserve scanning, pairing, or GATT connection pools for unused roles.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_CTRL_BLE_MAX_ACT=1
