# UART0 TX is GPIO20, which is the Quote/0 EPD power rail. Never let the IDF
# console claim it; USB Serial/JTAG (GPIO18/19) is the host transport.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# USB Serial/JTAG carries application messages, not a console. Suppress even the
# pre-application bootloader chatter so a host never mistakes text for a frame.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y

# 4 MiB custom layout: minimum-size 12 KiB NVS, OTA metadata, two 1.875 MiB
# app slots, and a 192 KiB LittleFS volume labelled `littlefs` (data/spiffs subtype required
# by esp_littlefs).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
# `run_display_loop` holds a canonical Frame plus its projected
# ControllerFrame (~11.3 KiB of pixel buffers alone) as locals, and debug
# builds additionally materialize full-frame temporaries inside
# `Frame::from_bytes`/`project`. Give the main task real headroom until the
# pixel paths are moved onto the heap.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads
# that allocate large stack variables; or better yet - use
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Low-rate frame appliance: reserve room for the panel, BLE, and web uploads.
# Keep the RX aggregation window within the number of static RX buffers.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=4
# Prefer heap headroom over high-throughput Wi-Fi code in instruction RAM.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Release TLS record buffers between reads/writes; keep the full 16 KiB
# inbound record limit for ordinary HTTPS servers.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# The implemented BLE feature is a non-connectable BTHome beacon. Do not
# reserve scanning, pairing, or GATT connection pools for deferred features.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_CTRL_BLE_MAX_ACT=1
